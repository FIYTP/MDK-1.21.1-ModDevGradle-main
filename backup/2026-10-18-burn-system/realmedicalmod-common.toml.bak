#出血与自然凝血系统配置
[bleeding]
	#每秒失血换算系数（将 mL/min 出血速率转换为每秒实际扣除的失血量，默认 1/60 即约 0.01667）
	#影响范围: 所有外出血扣减血容量
	#推荐范围: [0.005, 0.1]
	# Default: 0.016666666666666666
	# Range: 0.0 ~ 1.0
	bleedToBloodRatio = 0.016666666666666666
	#自然止血最大外出血阈值 (mL/min)。低于或等于此数值的创口在未包扎状态下可随时间自然凝血止血
	#推荐范围: [10, 100]
	# Default: 50
	# Range: 0 ~ 500
	naturalClottingThreshold = 50
	#轻微出血 (1 mL/min) 自然止血所需最短时间 (秒)
	#推荐范围: [30, 300]
	# Default: 60
	# Range: 1 ~ 3600
	naturalClottingMinTime = 60
	#中度出血 (50 mL/min) 自然止血所需最长时间 (秒)
	#推荐范围: [60, 600]
	# Default: 300
	# Range: 1 ~ 3600
	naturalClottingMaxTime = 300

#血容量自然回升系统配置（无活动性失血且饱食时缓慢恢复血容量）
[blood_regen]
	#是否启用血容量自然回升（关闭后完全禁用）
	enableBloodVolumeRegen = true
	#血容量每秒回升速率 (mL/s)
	#影响范围: 满足条件时的血容量恢复速度
	#推荐范围: [1, 20]
	# Default: 5.0
	# Range: 0.0 ~ 100.0
	bloodRegenRate = 5.0
	#触发回升所需的最低饱食度 (0~20)
	#推荐范围: [6, 20]
	# Default: 14
	# Range: 0 ~ 20
	bloodRegenFoodThreshold = 14

#血氧动态衰减与代偿系统配置
[blood_oxygen]
	#心脏骤停发生时每秒硬性扣除的血氧百分比 (%)
	#推荐范围: [10, 50]
	# Default: 20
	# Range: 0 ~ 100
	cardiacArrestOxygenLoss = 20
	#心室纤颤发生时每秒硬性扣除的血氧百分比 (%)
	#推荐范围: [5, 30]
	# Default: 10
	# Range: 0 ~ 100
	vfibOxygenLoss = 10
	#血容量 > 70% 时的每秒基础血氧恢复率 (%/s)
	#推荐范围: [0.1, 2.0]
	# Default: 0.5
	# Range: -10.0 ~ 10.0
	oxygenChangeRatio70 = 0.5
	#血容量在 50% ~ 70% 时的每秒基础血氧变化率 (%/s)
	#推荐范围: [-1.0, 0.0]
	# Default: -0.2
	# Range: -10.0 ~ 10.0
	oxygenChangeRatio50 = -0.2
	#血容量在 30% ~ 50% 时的每秒基础血氧变化率 (%/s)
	#推荐范围: [-2.0, 0.0]
	# Default: -0.5
	# Range: -10.0 ~ 10.0
	oxygenChangeRatio30 = -0.5
	#血容量在 10% ~ 30% 时的每秒基础血氧变化率 (%/s)
	#推荐范围: [-5.0, 0.0]
	# Default: -1.0
	# Range: -10.0 ~ 10.0
	oxygenChangeRatio10 = -1.0
	#血容量 <= 10% 时的每秒基础血氧变化率 (%/s)
	#推荐范围: [-10.0, 0.0]
	# Default: -2.0
	# Range: -10.0 ~ 10.0
	oxygenChangeRatioLow = -2.0
	#呼吸停止时血氧 > 70% 的每秒下降速率
	# Default: 0.3
	# Range: 0.0 ~ 10.0
	oxygenLossRespStopHigh = 0.3
	#呼吸停止时血氧 50~70% 的每秒下降速率
	# Default: 0.6
	# Range: 0.0 ~ 10.0
	oxygenLossRespStopMid = 0.6
	#呼吸停止时血氧 30~50% 的每秒下降速率
	# Default: 1.0
	# Range: 0.0 ~ 10.0
	oxygenLossRespStopLow = 1.0
	#呼吸停止时血氧 < 30% 的每秒下降速率
	# Default: 1.5
	# Range: 0.0 ~ 10.0
	oxygenLossRespStopCritical = 1.5
	#血容量 > 70% 时的每秒血氧恢复速率
	# Default: 2.0
	# Range: 0.0 ~ 10.0
	oxygenRecoveryRateHigh = 2.0
	#血容量 50~70% 时的每秒血氧恢复速率
	# Default: 1.0
	# Range: 0.0 ~ 10.0
	oxygenRecoveryRateMid = 1.0
	#血容量 30~50% 时的每秒血氧恢复速率
	# Default: 0.5
	# Range: 0.0 ~ 10.0
	oxygenRecoveryRateLow = 0.5
	#血容量 < 30% 时的每秒血氧恢复速率
	# Default: 0.2
	# Range: 0.0 ~ 10.0
	oxygenRecoveryRateCrit = 0.2
	#呼吸频率每偏离基准 1 次/分的血氧变化率
	# Default: 0.3
	# Range: 0.0 ~ 5.0
	respirationEffectPerRate = 0.3
	#呼吸频率的血氧平衡基准（呼吸 = 此值时血氧不变）
	# Default: 10.0
	# Range: 5.0 ~ 20.0
	respirationBaseline = 10.0
	#呼吸完全停止时每秒的血氧下降速率
	# Default: -5.0
	# Range: -20.0 ~ 0.0
	respirationStopEffect = -5.0
	#水下屏息缓冲时间 (秒，在此时间内肺部存氧可维持血氧，不发生剧烈缺氧)
	# Default: 15
	# Range: 0 ~ 60
	underwaterBreathHoldTime = 15
	#水下屏息期间每秒的血氧基础消耗率
	# Default: 0.2
	# Range: 0.0 ~ 2.0
	breathHoldOxygenLoss = 0.2

#脑健康度消耗与缓慢自愈机制
[brain_health]
	#心脏骤停发生时每秒扣除的脑健康点数 (%)
	#推荐范围: [2, 20]
	# Default: 5
	# Range: 0 ~ 100
	cardiacArrestBrainLoss = 5
	#心室纤颤发生时每秒扣除的脑健康点数 (%)
	#推荐范围: [1, 10]
	# Default: 2
	# Range: 0 ~ 100
	vfibBrainLoss = 2
	#脑健康无条件自然恢复的触发间隔周期 (秒，默认 60s 恢复 1 点)
	#推荐范围: [10, 300]
	# Default: 60
	# Range: 1 ~ 3600
	brainHealthRegenInterval = 60
	#每次自然恢复触发时回复的脑健康数值 (%)
	#推荐范围: [1, 5]
	# Default: 1
	# Range: 1 ~ 100
	brainHealthRegenAmount = 1
	#血氧 >= 90% 且供血充盈时的脑健康微量恢复速率 (%/s)
	#推荐范围: [0.0, 1.0]
	# Default: 0.1
	# Range: -10.0 ~ 10.0
	brainLossOxygen90 = 0.1
	#血氧在 50% ~ 70% 时的脑健康每秒消耗速率 (%/s)
	#推荐范围: [-1.0, 0.0]
	# Default: -0.2
	# Range: -10.0 ~ 10.0
	brainLossOxygen50 = -0.2
	#血氧在 30% ~ 50% 时的脑健康每秒消耗速率 (%/s)
	#推荐范围: [-2.0, 0.0]
	# Default: -0.5
	# Range: -10.0 ~ 10.0
	brainLossOxygen30 = -0.5
	#血氧 < 30% 严重缺氧时的脑健康每秒消耗速率 (%/s)
	#推荐范围: [-5.0, 0.0]
	# Default: -1.0
	# Range: -10.0 ~ 10.0
	brainLossOxygenLow = -1.0

#意识清醒度调控与呼吸/疼痛惩罚
[consciousness]
	#意识每秒自然恢复的基准量 (%)
	#推荐范围: [0.5, 5.0]
	# Default: 1.0
	# Range: 0.0 ~ 10.0
	consciousnessBaseRecovery = 1.0
	#体感疼痛(0~55)换算为意识每秒惩罚的除数 (penalty = perceivedPain / divisor)
	#推荐范围: [15.0, 50.0]
	# Default: 25.0
	# Range: 1.0 ~ 200.0
	painPenaltyDivisor = 25.0
	#血氧在 80% ~ 90% 区间时每秒扣除的意识点数 (%)
	#推荐范围: [0.0, 2.0]
	# Default: 0.0
	# Range: 0.0 ~ 10.0
	oxygenPenalty90 = 0.0
	#血氧在 70% ~ 80% 区间时每秒扣除的意识点数 (%)
	#推荐范围: [0.0, 3.0]
	# Default: 0.0
	# Range: 0.0 ~ 10.0
	oxygenPenalty80 = 0.0
	#血氧在 50% ~ 70% 区间时每秒扣除的意识点数 (%)
	#推荐范围: [0.1, 2.0]
	# Default: 0.5
	# Range: 0.0 ~ 10.0
	oxygenPenalty70 = 0.5
	#血氧在 30% ~ 50% 区间时每秒扣除的意识点数 (%)
	#推荐范围: [0.5, 3.0]
	# Default: 1.5
	# Range: 0.0 ~ 10.0
	oxygenPenalty50 = 1.5
	#血氧在 20% ~ 30% 区间时每秒扣除的意识点数 (%)
	#推荐范围: [1.0, 5.0]
	# Default: 3.0
	# Range: 0.0 ~ 20.0
	oxygenPenalty30 = 3.0
	#血氧 < 20% 严重缺氧区间时每秒扣除的意识点数 (%)
	#推荐范围: [3.0, 10.0]
	# Default: 5.0
	# Range: 0.0 ~ 50.0
	oxygenPenaltyCritical = 5.0

#心电动力学与窦性调节
[heart_rate]
	#健康人体基础静息心率 (bpm)
	#推荐范围: [60, 90]
	# Default: 75
	# Range: 30 ~ 120
	restingHeartRate = 75
	#代偿性窦性心动过速的最大允许心率上限 (bpm)
	#推荐范围: [180, 240]
	# Default: 200
	# Range: 150 ~ 300
	maxHeartRate = 200
	#全身疼痛等级对心率加速的加成系数 (bpm/级)
	#推荐范围: [2.0, 8.0]
	# Default: 4.0
	# Range: 0.0 ~ 20.0
	painHeartRateMultiplier = 4.0
	#呼吸停止 (<=0) 时对心率的减慢修正值 (bpm)
	#推荐范围: [-40.0, 0.0]
	# Default: -20.0
	# Range: -100.0 ~ 100.0
	respModStop = -20.0
	#呼吸过缓 (<8 次/分) 时对心率的减慢修正值 (bpm)
	#推荐范围: [-20.0, 0.0]
	# Default: -10.0
	# Range: -100.0 ~ 100.0
	respModSlow = -10.0

#呼吸中枢与通气调节
[respiration]
	#静息基础呼吸频率 (次/分)
	#推荐范围: [12, 18]
	# Default: 14
	# Range: 6 ~ 30
	baseRespiration = 14
	#连续奔跑运动带来的最大呼吸频率增益 (次/分)
	#推荐范围: [15.0, 40.0]
	# Default: 28.0
	# Range: 0.0 ~ 60.0
	maxRunningRespirationBonus = 28.0
	#奔跑增益达到最大所需持续奔跑时间 (秒)
	#推荐范围: [120, 600]
	# Default: 300
	# Range: 10 ~ 1200
	runningBonusMaxTime = 300
	#触发屏幕边缘全屏红框警告的呼吸过缓下限门槛 (次/分)
	#推荐范围: [4, 8]
	# Default: 6
	# Range: 1 ~ 15
	extremeRespLowThreshold = 6
	#触发屏幕边缘全屏红框警告的过度换气上限门槛 (次/分)
	#推荐范围: [35, 55]
	# Default: 40
	# Range: 25 ~ 80
	extremeRespHighThreshold = 40
	#呼吸频率绝对上限 (次/分)
	#推荐范围: [40, 80]
	# Default: 50
	# Range: 20 ~ 120
	maxRespiration = 50

#心脏急症与濒危状态阈值
[cardiac_arrest]
	#触发 5 秒濒危倒计时的失血性休克血容量门槛 (mL，人体总量 5000 mL)
	#推荐范围: [2000, 3500]
	# Default: 3000
	# Range: 500 ~ 4500
	criticalBloodVolume = 3000
	#濒危状态到心脏骤停的倒计时时长 (秒)
	#推荐范围: [3, 10]
	# Default: 5
	# Range: 1 ~ 120
	criticalTimerMax = 5
	#触发心室纤颤倒计时的恶性心动过速心率阈值 (bpm)
	#推荐范围: [180, 230]
	# Default: 190
	# Range: 150 ~ 240
	vfibThreshold = 190
	#维持恶性心动过速触发室颤所需的持续秒数 (秒)
	#推荐范围: [15, 60]
	# Default: 30
	# Range: 5 ~ 120
	vfibDuration = 30
	#触发缺氧性室颤倒计时的血氧饱和度极限阈值 (%)
	#推荐范围: [10, 30]
	# Default: 20
	# Range: 1 ~ 50
	severeHypoxiaThreshold = 20
	#血氧低于极限阈值持续该秒数后触发缺氧性室颤 (秒)
	#推荐范围: [15, 60]
	# Default: 30
	# Range: 5 ~ 120
	severeHypoxiaDuration = 30
	#触发停搏倒计时的严重心动过缓心率阈值 (bpm)
	#推荐范围: [20, 45]
	# Default: 40
	# Range: 10 ~ 60
	bradyArrestThreshold = 40
	#维持严重心动过缓触发心脏骤停所需的持续秒数 (秒)
	#推荐范围: [15, 60]
	# Default: 30
	# Range: 5 ~ 120
	bradyDuration = 30

#运动强度计算与体力活动
[exercise]
	#疾跑冲刺时的目标运动强度 (0.0 ~ 1.0)
	#推荐范围: [0.4, 0.8]
	# Default: 0.6
	# Range: 0.0 ~ 1.0
	sprintExerciseIntensity = 0.6
	#跳跃与滞空时的最低目标运动强度 (0.0 ~ 1.0)
	#推荐范围: [0.1, 0.4]
	# Default: 0.2
	# Range: 0.0 ~ 1.0
	jumpExerciseIntensity = 0.2
	#挥击攻击/破坏方块后激发交感神经兴奋维持的时间 (秒)
	#推荐范围: [5, 20]
	# Default: 10
	# Range: 1 ~ 60
	attackTimerDuration = 10

#疼痛感应与自然衰退
[pain]
	#各肢体疼痛等级自然衰退 1 级所需时间 (秒)
	#推荐范围: [30, 180]
	# Default: 60
	# Range: 1 ~ 600
	painDecayInterval = 60
	#单肢体最高允许记录的疼痛等级上限
	#推荐范围: [10, 20]
	# Default: 10
	# Range: 1 ~ 20
	maxPainLevel = 10

#创伤与跌落机制
[damage]
	#安全坠落距离阈值 (格)。低于此值的坠落不产生骨折、出血或疼痛
	#推荐范围: [3.0, 8.0]
	# Default: 5.0
	# Range: 0.0 ~ 20.0
	safeFallDistance = 5.0
	#头部遭受单次伤害触发脑损伤的最小伤害值
	#推荐范围: [3.0, 10.0]
	# Default: 5.0
	# Range: 0.0 ~ 20.0
	headBrainDamageThreshold = 5.0

#客户端视觉与粒子呈现
[effects]
	#开始在玩家身周生成出血滴落粒子的全身出血速率门槛 (mL/min)
	#推荐范围: [20, 100]
	# Default: 50
	# Range: 0 ~ 500
	bleedParticleThreshold = 50
	#客户端文本开始出现字形乱码与抖动错位的脑健康阈值 (%)
	#推荐范围: [70, 95]
	# Default: 90
	# Range: 10 ~ 100
	brainDamageFontThreshold = 90
	#极端呼吸异常触发的全屏边缘警告框像素宽度
	#推荐范围: [8, 32]
	# Default: 16
	# Range: 1 ~ 64
	respBorderThickness = 16
	#脑损伤突发效果触发的脑健康阈值 (%)
	# Default: 90
	# Range: 10 ~ 100
	brainDamageTriggerThreshold = 90
	#脑损伤突发效果检查间隔 (秒)
	# Default: 30
	# Range: 1 ~ 300
	brainDamageTriggerInterval = 30
	#脑损伤突发效果每次检查的触发概率 (0.0~1.0)
	# Default: 0.2
	# Range: 0.0 ~ 1.0
	brainDamageTriggerChance = 0.2
	#脑损伤突发效果触发后的冷却时间 (秒)
	# Default: 30
	# Range: 1 ~ 300
	brainDamageTriggerCooldown = 30
	#突发效果中冲击定格的相对权重/概率
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	brainDamageShockChance = 0.5
	#突发效果中按键颠倒的相对权重/概率
	# Default: 0.25
	# Range: 0.0 ~ 1.0
	brainDamageInputInvertChance = 0.25
	#突发效果中视角颠倒的相对权重/概率
	# Default: 0.25
	# Range: 0.0 ~ 1.0
	brainDamageViewInvertChance = 0.25
	#按键/视角颠倒持续时间下限 (秒)
	# Default: 3
	# Range: 1 ~ 30
	brainDamageInvertDurationMin = 3
	#按键/视角颠倒持续时间上限 (秒)
	# Default: 5
	# Range: 1 ~ 30
	brainDamageInvertDurationMax = 5

#客户端危机音效系统
[sound]
	#是否启用危机分层动态音效（包含心跳、监护仪不规则警报、喘息、骤停重音等）
	enableCrisisSound = true
	#心跳音效全局音量加成倍数
	#推荐范围: [0.5, 1.5]
	# Default: 1.0
	# Range: 0.0 ~ 2.0
	crisisHeartbeatVolume = 1.0
	#心跳音效触发的血容量上限阈值（低于此值触发）
	# Default: 3500
	# Range: 0 ~ 5000
	heartbeatTriggerBloodVolume = 3500
	#心跳音效触发的高心率上限阈值（高于此值且非运动诱导时触发）
	# Default: 150
	# Range: 60 ~ 300
	heartbeatTriggerMaxHeartRate = 150
	#心跳音效触发的低心率下限阈值（低于此值触发严重过缓心跳）
	# Default: 45
	# Range: 10 ~ 100
	heartbeatTriggerMinHeartRate = 45

#内出血系统
[internal_bleeding]
	#触发内出血的最低伤害量
	# Default: 8
	# Range: 1 ~ 100
	triggerDamageThreshold = 8
	#每点伤害对应的内出血速率 (mL/min)
	# Default: 5.0
	# Range: 0.1 ~ 50.0
	ratePerDamage = 5.0
	#内出血速率上限 (mL/min)
	# Default: 80
	# Range: 1 ~ 500
	maxInternalRate = 80
	#四肢内出血的自愈阈值 (mL/min)，低于此值可自愈
	# Default: 5
	# Range: 0 ~ 100
	selfHealThreshold = 5
	#自愈间隔 (秒)，每N秒衰减1点速率
	# Default: 60
	# Range: 1 ~ 600
	selfHealInterval = 60
	#胸部受击触发内出血的概率
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	chestTriggerChance = 0.5
	#四肢受击触发内出血的概率
	# Default: 0.15
	# Range: 0.0 ~ 1.0
	limbTriggerChance = 0.15
	#坠落冲击触发内出血的概率
	# Default: 0.4
	# Range: 0.0 ~ 1.0
	fallTriggerChance = 0.4
	#四肢内出血速率的倍率（相对于胸部）
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	limbRateMultiplier = 0.5

#头部和胸部的内出血不会自愈
#血胸系统
[hemothorax]
	#胸部内出血累积到胸腔的比例 (0~1)
	# Default: 0.7
	# Range: 0.0 ~ 1.0
	accumulationRatio = 0.7
	#胸腔积血上限 (mL)
	# Default: 2000
	# Range: 100 ~ 5000
	maxChestAccumulation = 2000
	#血胸等级1阈值 (mL)
	# Default: 500
	# Range: 0 ~ 2000
	level1Threshold = 500
	#血胸等级2阈值 (mL)
	# Default: 1000
	# Range: 0 ~ 2000
	level2Threshold = 1000
	#血胸等级3阈值 (mL)
	# Default: 1500
	# Range: 0 ~ 2000
	level3Threshold = 1500
