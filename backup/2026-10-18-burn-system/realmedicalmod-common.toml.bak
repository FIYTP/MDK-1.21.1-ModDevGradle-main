	#SIRS 4 级每秒血容量损失 (mL)
	# Default: 0.3
	# Range: 0.0 ~ 10.0
	bloodLossL4 = 2.0
	#SIRS 1 级的外周阻力倍率
	# Default: 0.95
	# Range: 0.1 ~ 1.5
	sirsTprModifierL1 = 0.95
	#SIRS 2 级的外周阻力倍率
	# Default: 0.85
