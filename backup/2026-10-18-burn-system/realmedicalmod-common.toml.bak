	# Range: 0.0 ~ 1.0
	armFractureNoSplintAttackMultiplier = 0.3
	#手臂已夹板挖掘速度倍率
	# Default: 0.7
	# Range: 0.0 ~ 1.0
	armFractureSplintMiningMultiplier = 0.7
	#手臂已夹板攻击力倍率
	# Default: 0.7
	# Range: 0.0 ~ 1.0
	armFractureSplintAttackMultiplier = 0.7
	#骨折时每点伤害对应的内出血速率 (mL/min)
	# Default: 5.0
	# Range: 0.5 ~ 50.0
	fractureBleedPerDamage = 5.0
	#骨折内出血速率上限 (mL/min)
	# Default: 200.0
	# Range: 10.0 ~ 500.0
	fractureBleedMax = 200.0
	#四肢骨折的内出血倍率
	# Default: 1.0
	# Range: 0.0 ~ 3.0
	fractureLimbMultiplier = 1.0
	#胸部骨折的内出血倍率
	# Default: 0.5
	# Range: 0.0 ~ 3.0
	fractureChestMultiplier = 0.5
	#二次创伤导致的肢体内出血上限 (mL/min)，模拟肌筋膜间隙内骨折血肿压迫自限止血机制
	# Default: 80
	# Range: 0 ~ 1000
	secondaryTraumaMaxInternalBleed = 80
	#二次创伤导致的开放性骨折外出血上限 (mL/min)
	# Default: 60
	# Range: 0 ~ 1000
	secondaryTraumaMaxExternalBleed = 60

#肺挫伤系统
[lung_contusion]
	#肺挫伤 (0~20%] 时的呼吸倍率
	# Default: 0.95
	# Range: 0.0 ~ 1.0
	contusion20RespirationMult = 0.95
	#肺挫伤 (20~40%] 时的呼吸倍率
	# Default: 0.85
	# Range: 0.0 ~ 1.0
	contusion40RespirationMult = 0.85
	#肺挫伤 (40~60%] 时的呼吸倍率
	# Default: 0.7
	# Range: 0.0 ~ 1.0
	contusion60RespirationMult = 0.7
	#肺挫伤 (60~80%] 时的呼吸倍率
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	contusion80RespirationMult = 0.5
	#肺挫伤 (80~100%] 时的呼吸倍率
	# Default: 0.3
	# Range: 0.0 ~ 1.0
	contusion100RespirationMult = 0.3
	#肺挫伤血氧每秒基础惩罚系数
	# Default: 0.05
	# Range: 0.0 ~ 2.0
	contusionOxygenPenalty = 0.05

#免疫治疗系统
[immunity]
	#基础免疫治疗速率（每秒降低的感染值）
	#100 点感染值从满到 0 需要约 1/0.10 = 1000 秒 ≈ 17 分钟
	# Default: 0.1
	# Range: 0.0 ~ 5.0
	immuneBaseRate = 0.1
	#饱食度 ≥ 18（饱腹）时的免疫治疗倍率
	# Default: 2.5
	# Range: 0.0 ~ 10.0
	immuneHungerHighMult = 2.5
	#饱食度 14~17 时的免疫治疗倍率
	# Default: 1.5
	# Range: 0.0 ~ 10.0
	immuneHungerMidMult = 1.5
	#饱食度 8~13（正常）时的免疫治疗倍率
	# Default: 1.0
	# Range: 0.0 ~ 10.0
	immuneHungerLowMult = 1.0
	#饱食度 3~7（饥饿）时的免疫治疗倍率
	# Default: 0.5
	# Range: 0.0 ~ 10.0
	immuneHungerCritMult = 0.5
	#饱食度 < 3（濒饿）时的免疫治疗倍率
	# Default: 0.2
	# Range: 0.0 ~ 10.0
	immuneHungerStarveMult = 0.2
	#消毒剂效果持续秒数
	# Default: 60
	# Range: 1 ~ 600
	disinfectantDuration = 60
	#消毒剂生效期间的免疫治疗加速倍率
	# Default: 2.0
	# Range: 1.0 ~ 10.0
	disinfectantImmuneMult = 2.0
	#消毒剂生效期间是否完全阻止感染值增长
	disinfectantBlocksGrowth = true

#连续仲裁 buff 系统：伤情→能力倍率连续插值，属性仲裁与感知药水统一配置
[arbitrated_buffs]
	#属性仲裁器每维度倍率下限（防归零保护）
	# Default: 0.05
	# Range: 0.0 ~ 1.0
	arbiterMinMultiplier = 0.05
	#感知药水等级切换的滞回缓冲（tick），防边界抖动
	# Default: 40
	# Range: 0 ~ 200
	potionHysteresisTicks = 40
	#腿部疼痛每级对移速的线性斜率（1 - slope*p，p 为体感疼痛 0~55）
	# Default: 0.006
	# Range: 0.0 ~ 1.0
	painLegSpeedSlope = 0.006
	#手臂疼痛每级对攻击力的线性斜率
	# Default: 0.008
	# Range: 0.0 ~ 1.0
	painArmAttackSlope = 0.008
	#手臂疼痛每级对攻速的线性斜率
	# Default: 0.006
	# Range: 0.0 ~ 1.0
	painArmSpeedSlope = 0.006
	#头部疼痛每级对失明药水等级的插值斜率（按 0~10 疼痛线性）
	# Default: 0.15
	# Range: 0.0 ~ 1.0
	painHeadBlindnessSlope = 0.15
	#胸部疼痛每级对反胃药水等级的插值斜率
	# Default: 0.15
	# Range: 0.0 ~ 1.0
	painChestNauseaSlope = 0.15
	#失血每 1% 对移速的线性斜率（b 为失血百分比 0~100）
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	bloodLossSpeedSlope = 0.5
	#失血每 1% 对攻击力的线性斜率
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	bloodLossAttackSlope = 0.5
	#失血每 1% 对挖掘（DIG_SLOWDOWN 插值）的线性斜率
	# Default: 0.4
	# Range: 0.0 ~ 1.0
	bloodLossDigSlope = 0.4
	#低血氧乏力开始阈值（SpO2 低于此值开始惩罚）
	# Default: 90
	# Range: 50 ~ 100
	hypoxiaOnsetSpo2 = 90
	#SpO2 到 0 时的最大能力衰减比例（0.7 = 倍率压到 0.3）
	# Default: 0.7
	# Range: 0.0 ~ 1.0
	hypoxiaMaxPenalty = 0.7
	#SIRS 每级的疲劳衰减比例（倍率 = 1 - 系数*等级/4，脓毒症休克另有下限）
	# Default: 0.08
	# Range: 0.0 ~ 0.25
	sirsFatiguePerLevel = 0.08
	#脓毒症（SIRS L4）全身倍率下限
	# Default: 0.3
	# Range: 0.0 ~ 1.0
	sepsisMinMultiplier = 0.3
	#意识对攻击/挖掘能力的影响系数（倍率 = 1 - factor*(1 - c/100)）
	# Default: 0.8
	# Range: 0.0 ~ 1.0
	conscImpactFactor = 0.8
	#意识为 0（昏迷）时的能力倍率，替代旧 weakness 255 硬压制
	# Default: 0.05
	# Range: 0.0 ~ 1.0
	conscImpactUnconscious = 0.05
	#血胸 L3 移速倍率
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	hemothoraxL3SpeedMultiplier = 0.5
	#血胸 L4 移速倍率
	# Default: 0.05
	# Range: 0.0 ~ 1.0
	hemothoraxL4SpeedMultiplier = 0.05
	#肺挫伤每 1% 对移速/攻速的疲劳斜率
	# Default: 0.4
	# Range: 0.0 ~ 1.0
	contusionFatigueSlope = 0.4
	#颅内出血 L3 失明药水等级
	# Default: 1
	# Range: 0 ~ 5
	icBlindnessL3 = 1
	#颅内出血 L4 失明药水等级
	# Default: 2
	# Range: 0 ~ 5
	icBlindnessL4 = 2
	#体感疼痛触发失明插值的阈值（体感疼痛 0~55）
	# Default: 40
	# Range: 0 ~ 55
	perceivedPainBlindnessThreshold = 40
	#体感疼痛触发反胃插值的阈值
	# Default: 35
	# Range: 0 ~ 55
	perceivedPainNauseaThreshold = 35
	#臂骨折（未夹板）对应的挖掘迟缓药水最大等级（插值：夹板状态按倍率比例折算）
	# Default: 3
	# Range: 0 ~ 10
	digSlowdownFractureMaxLevel = 3

#中毒系统：poison 伤害转毒素条（0~100），全身性生理影响（呼吸/血氧/意识/血压/凝血/感染/心律）
[toxin]
	#每次 poison 伤害事件转毒素条的累加系数（毒素 += 伤害量 × 系数）
	#原版 Poison I 每 1.25s 扣 1 点伤害，Poison II 0.6s 扣 1 点
	#系数 6 时 Poison I 约 8 分钟充满，Poison II 约 4 分钟充满
	# Default: 6.0
	# Range: 0.0 ~ 100.0
	accumulationRate = 6.0
	#毒素自然代谢速率（每秒循环扣减，默认 0.25 = 15点/分钟）
	# Default: 0.25
	# Range: 0.0 ~ 10.0
	decayRate = 0.25
	#饱食度≥18 时的代谢加成倍率（免疫健康态代谢更快）
	# Default: 2.0
	# Range: 0.1 ~ 10.0
	immuneDecayMult = 2.0
	#轻度中毒阈值：达到后反胃/腹痛（nausea 插值）
	# Default: 20.0
	# Range: 0.0 ~ 100.0
	mildThreshold = 20.0
	#中度中毒阈值：达到后呼吸抑制、血氧下降、意识下降、血压下降（分布性休克）
	# Default: 40.0
	# Range: 0.0 ~ 100.0
	midThreshold = 40.0
	#重度中毒阈值：达到后感染值抬升（→SIRS 链）、凝血障碍
	# Default: 70.0
	# Range: 0.0 ~ 100.0
	severeThreshold = 70.0
	#濒死中毒阈值：达到后室颤概率加倍
	# Default: 90.0
	# Range: 0.0 ~ 100.0
	criticalThreshold = 90.0
	#轻度反胃药水插值斜率（每点毒素升的等级数，毒素100时约4级）
	# Default: 0.05
	# Range: 0.0 ~ 1.0
	nauseaSlope = 0.05
	#毒素呼吸频率上抬斜率（浅快呼吸，每点毒素 +N 次/分，毒素100时 +6）
	# Default: 0.1
	# Range: 0.0 ~ 5.0
	respRateSlope = 0.1
	#毒素换气效率折减斜率（呼吸肌抑制，每点毒素乘 1-slope×超阈量）
	# Default: 0.003
	# Range: 0.0 ~ 0.1
	respSuppressionSlope = 0.003
	#毒素直接意识惩罚斜率（每点毒素每秒扣意识，毒素100时 3.0/s；血氧传导惩罚另计）
	# Default: 0.05
	# Range: 0.0 ~ 1.0
	consciousnessSlope = 0.05
	#毒素血管扩张 TPR 斜率（分布性休克，每点毒素乘 1-slope×超阈量，毒素100时 ×0.76）
	# Default: 0.004
	# Range: 0.0 ~ 0.1
	tprSlope = 0.004
	#毒素心肌抑制每搏输出量斜率（每点毒素乘 1-slope×超阈量）
	# Default: 0.004
	# Range: 0.0 ~ 0.1
	strokeVolumeSlope = 0.004
	#重度中毒时每秒抬升的感染累加值（分摊到全部肢体，走现有感染→SIRS 自动晋级链）
	# Default: 0.5
	# Range: 0.0 ~ 10.0
	infectionRate = 0.5
	#重度中毒每秒触发毒素性室颤的基础概率（濒死阈值以上加倍）
	# Default: 0.005
	# Range: 0.0 ~ 1.0
	vfibChance = 0.005
	#重度中毒时自然凝血时间倍率（毒素诱发消耗性凝血病）
	# Default: 1.5
	# Range: 0.1 ~ 10.0
	clottingTimeMult = 1.5
